# ============================================================
# STABLE-SL ENVIRONMENT VARIABLES (shared across apps)
# Copy to apps/.env and fill real values (apps/.env is gitignored)
# ============================================================

# ---------- Frontend (apps/stable-sl) ----------
NEXT_PUBLIC_COORDINATOR=/api
NEXT_PUBLIC_NETWORK=celoSepolia
PORT=9002

# ---------- Database (kysely + m db commands use PG* vars) ----------
PGHOST=/var/www/var/run/postgresql
PGPORT=5432
PGDATABASE=stablesldev
PGUSER=stablesl
PGPASSWORD=MyPassword
DATABASE_URL=postgres://stablesl:MyPassword@localhost:5432/stablesldev
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Test variants (used when NODE_ENV=test / vitest)
PGDATABASE_TEST=stablesldev
PGUSER_TEST=stablesl
PGPASSWORD_TEST=MyPassword

# ---------- Orange Money (API) ----------
PHONE="075123456"
PHONE_NAME="Happy Unpaid"
ORANGEPASS="1234"
IDPHONE="xyz"

# ---------- Blockchain ----------
RPC_URL=https://celo-sepolia.g.alchemy.com/v2/YOUR_API_ID
EXPLORER_TX=https://sepolia.celoscan.io/tx/

# ---------- Wallet ----------
