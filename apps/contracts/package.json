  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.5",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.11",
    "@nomicfoundation/ignition-core": "^0.15.5",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "chai": "^4.2.0",
    "chain": "^0.4.0",
    "hardhat": ">=2.27.0 <3.0.0",
    "hardhat-gas-reporter": "^1.0.8",
    "minimatch": "^10.0.3",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "catalog:"
  },
  "dependencies": {
    "dotenv": "catalog:"
  },
  "scripts": {
    "postinstall": "chmod +x sync-abis.js",
    "compile": "hardhat compile && node sync-abis.js",
    "tsc": "tsc -p . && mkdir -p dist/typechain-types/ && cp typechain-types/*.d.ts dist/typechain-types/",
    "build": "pnpm compile && pnpm tsc",
    "clean": "hardhat clean",
    "run:node": "hardhat node",
    "test": "../web/bin/m contract:test",
    "deploy-mock-g": "hardhat run scripts/deployMockG.ts --network celoSepolia",
    "verify-mock-g": "hardhat run scripts/verifyMockG.ts --network celoSepolia",
    "contract-verification": "bin/contract-verification",
    "prettier": "prettier --write 'contracts/**/*.sol' '**/*.ts'",
    "sync:abis": "node sync-abis.js",
    "checkdeploy": "../web/bin/m contract:checkdeploy"
  },
  "author": "pasosdeJesus"
}
